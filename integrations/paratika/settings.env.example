# Gerçek değerleri yalnız .env.local veya Vercel güvenli ortam ayarlarına ekleyin.
# Bu dosyada parola tutmayın. NEXT_PUBLIC_ öneki kullanmayın.
PARATIKA_MODE=test
PARATIKA_PUBLIC_ORIGIN=https://www.nibatarim.com
PARATIKA_ENABLED=false
PARATIKA_LIVE_ENABLED=false
# Ortam ve üye iş yeri başına ayrı API kullanıcısı:
PARATIKA_TEST_10013929_USER=
PARATIKA_TEST_10013929_PASSWORD=
PARATIKA_TEST_10013922_USER=
PARATIKA_TEST_10013922_PASSWORD=
PARATIKA_LIVE_10013929_USER=
PARATIKA_LIVE_10013929_PASSWORD=
PARATIKA_LIVE_10013922_USER=
PARATIKA_LIVE_10013922_PASSWORD=
# Paraşüt bloke hesap kimlikleri, üye iş yeri başına:
PARATIKA_10013929_PARASUT_ACCOUNT_ID=
PARATIKA_10013922_PARASUT_ACCOUNT_ID=
# Yalnız sözleşme/sağlayıcıyla doğrulanmış Niba komisyon tarifesi.
# Anahtar: ortam:üyeİşyeri:QUERYINSTALLMENT sistem adı:taksit sayısı
# Değer: yüzde. Eksikse komisyon/net tutar hesaplanmaz. Örnek yüzde eklenmemiştir.
PARATIKA_VERIFIED_TARIFFS_JSON={}
